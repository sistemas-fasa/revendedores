# Mínimo por rotación: semanal domingos 04:15, fuera del barrido nocturno (03:10)
# y del actualizador horario (:00). Cap 30m; lock propio en /data/locks.
15 4 * * 0 root JOB_NAME=stock_minimum JOB_TIMEOUT_SECONDS=1800 JOB_COMMAND='python3 /opt/automatizaciones/jobs/stock_minimum.py --coverage-days 14' JOB_LOCK_FILE=/data/locks/stock_minimum.lock /usr/local/bin/automatizaciones-runner >> /data/logs/linux/stock_minimum/stock-minimum-cron.log 2>&1
